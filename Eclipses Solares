const menuBtn = document.getElementById("menuBtn");
const nav = document.querySelector(".nav");

menuBtn.addEventListener("click", () => {
  nav.classList.toggle("open");
});

document.querySelectorAll(".nav a").forEach(link => {
  link.addEventListener("click", () => nav.classList.remove("open"));
});

// Tarjetas de tipos de eclipse
document.querySelectorAll(".type-card").forEach(card => {
  card.addEventListener("click", () => {
    document.querySelectorAll(".type-card").forEach(c => c.classList.remove("active"));
    card.classList.add("active");
  });
});

// Simulador
const moonPosition = document.getElementById("moonPosition");
const simMoon = document.getElementById("simMoon");
const simSpace = document.getElementById("simSpace");
const positionValue = document.getElementById("positionValue");
const coverageValue = document.getElementById("coverageValue");
const eclipseType = document.getElementById("eclipseType");
const resetSim = document.getElementById("resetSim");

function updateSimulator() {
  const value = Number(moonPosition.value);
  const centered = 50;
  const distance = Math.abs(value - centered);

  // El rango visual se mantiene dentro del contenedor.
  const maxShift = Math.max(80, simSpace.clientWidth / 2 - 130);
  const shift = ((value - 50) / 50) * maxShift;

  simMoon.style.left = `calc(50% - 110px + ${shift}px)`;
  positionValue.textContent = `${value}%`;

  // Aproximación visual sencilla para fines educativos.
  let coverage = Math.max(0, Math.round(100 - distance * 3.2));

  coverageValue.textContent = `${coverage}%`;

  if (coverage >= 92) {
    eclipseType.textContent = "Total";
  } else if (coverage >= 12) {
    eclipseType.textContent = "Parcial";
  } else {
    eclipseType.textContent = "Sin eclipse";
  }
}

moonPosition.addEventListener("input", updateSimulator);
window.addEventListener("resize", updateSimulator);

resetSim.addEventListener("click", () => {
  moonPosition.value = 50;
  updateSimulator();
});

updateSimulator();

// Quiz interactivo
const quizData = [
  {
    question: "¿Qué astro se ubica entre el Sol y la Tierra durante un eclipse solar?",
    options: ["Marte", "La Luna", "Venus", "Júpiter"],
    correct: 1
  },
  {
    question: "¿En qué tipo de eclipse se observa un 'anillo de fuego'?",
    options: ["Total", "Parcial", "Anular", "Lunar"],
    correct: 2
  },
  {
    question: "¿Cuál es una forma segura de observar el Sol durante un eclipse?",
    options: [
      "Con gafas de sol comunes",
      "Mirando unos segundos",
      "Con filtro solar certificado",
      "A través de un celular sin filtro"
    ],
    correct: 2
  }
];

let currentQuestion = 0;
let score = 0;
let answered = false;

const questionCounter = document.getElementById("questionCounter");
const questionText = document.getElementById("questionText");
const answers = document.getElementById("answers");
const feedback = document.getElementById("feedback");
const nextQuestion = document.getElementById("nextQuestion");
const progressBar = document.getElementById("progressBar");

function renderQuestion() {
  answered = false;
  nextQuestion.disabled = true;

  const item = quizData[currentQuestion];
  questionCounter.textContent = `Pregunta ${currentQuestion + 1} de ${quizData.length}`;
  questionText.textContent = item.question;
  progressBar.style.width = `${((currentQuestion + 1) / quizData.length) * 100}%`;
  feedback.textContent = "Selecciona una respuesta.";
  answers.innerHTML = "";

  item.options.forEach((option, index) => {
    const button = document.createElement("button");
    button.className = "answer-btn";
    button.textContent = option;
    button.addEventListener("click", () => selectAnswer(index, button));
    answers.appendChild(button);
  });
}

function selectAnswer(index, button) {
  if (answered) return;
  answered = true;

  const item = quizData[currentQuestion];
  const allButtons = [...document.querySelectorAll(".answer-btn")];

  if (index === item.correct) {
    button.classList.add("correct");
    feedback.textContent = "¡Correcto! Muy bien.";
    score++;
  } else {
    button.classList.add("wrong");
    allButtons[item.correct].classList.add("correct");
    feedback.textContent = "No era esa. La respuesta correcta quedó marcada.";
  }

  nextQuestion.disabled = false;
}

nextQuestion.addEventListener("click", () => {
  if (currentQuestion < quizData.length - 1) {
    currentQuestion++;
    renderQuestion();
  } else {
    questionCounter.textContent = "Resultado final";
    questionText.textContent = `Obtuviste ${score} de ${quizData.length} respuestas correctas.`;
    answers.innerHTML = "";
    feedback.textContent =
      score === quizData.length
        ? "¡Excelente! Dominas el tema."
        : "Puedes volver a repasar las secciones de la página y repetir el quiz.";
    nextQuestion.textContent = "Repetir quiz";
    nextQuestion.disabled = false;

    nextQuestion.onclick = () => {
      currentQuestion = 0;
      score = 0;
      nextQuestion.textContent = "Siguiente";
      nextQuestion.onclick = null;
      renderQuestion();
    };
  }
});

renderQuestion();

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

:root {
  --bg: #050816;
  --bg-2: #0a1024;
  --panel: rgba(15, 23, 48, 0.78);
  --panel-2: #101831;
  --text: #f5f7ff;
  --muted: #9aa7c5;
  --line: rgba(255, 255, 255, 0.10);
  --accent: #ffb703;
  --accent-2: #ff7b00;
  --blue: #7dd3fc;
  --danger: #ff6b6b;
  --green: #55e6a5;
  --shadow: 0 20px 60px rgba(0,0,0,.35);
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: "Inter", sans-serif;
  color: var(--text);
  background:
    radial-gradient(circle at 20% 0%, rgba(65, 105, 225, .18), transparent 30%),
    radial-gradient(circle at 90% 10%, rgba(255, 149, 0, .10), transparent 25%),
    var(--bg);
  line-height: 1.65;
  overflow-x: hidden;
}

body::before {
  content: "";
  position: fixed;
  inset: 0;
  pointer-events: none;
  opacity: .35;
  background-image:
    radial-gradient(circle at 15% 20%, #fff 0 1px, transparent 1px),
    radial-gradient(circle at 70% 18%, #fff 0 1px, transparent 1px),
    radial-gradient(circle at 40% 70%, #fff 0 1px, transparent 1px),
    radial-gradient(circle at 82% 76%, #fff 0 1px, transparent 1px),
    radial-gradient(circle at 30% 45%, #fff 0 1px, transparent 1px);
  background-size: 220px 220px, 300px 300px, 360px 360px, 280px 280px, 400px 400px;
}

a { color: inherit; text-decoration: none; }

.topbar {
  width: min(1180px, calc(100% - 32px));
  height: 72px;
  margin: 18px auto 0;
  padding: 0 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: sticky;
  top: 14px;
  z-index: 50;
  background: rgba(6, 10, 25, 0.72);
  border: 1px solid var(--line);
  border-radius: 18px;
  backdrop-filter: blur(14px);
  box-shadow: 0 12px 40px rgba(0,0,0,.24);
}

.brand {
  display: flex;
  gap: 10px;
  align-items: center;
  font-family: "Space Grotesk", sans-serif;
  font-weight: 700;
  font-size: 1.15rem;
}

.brand-icon {
  width: 34px;
  height: 34px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  color: #111827;
  background: linear-gradient(135deg, #ffd166, #ff8c00);
  box-shadow: 0 0 28px rgba(255, 183, 3, .32);
}

.nav {
  display: flex;
  gap: 24px;
  color: var(--muted);
  font-size: .92rem;
}

.nav a:hover { color: white; }

.menu-btn {
  display: none;
  border: 0;
  color: white;
  background: transparent;
  font-size: 1.4rem;
}

.hero {
  width: min(1180px, calc(100% - 32px));
  min-height: 760px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1.05fr .95fr;
  align-items: center;
  gap: 60px;
  padding: 80px 0;
}

.eyebrow {
  color: var(--accent);
  letter-spacing: .18em;
  font-size: .74rem;
  font-weight: 800;
  margin-bottom: 16px;
}

.hero h1,
.section h2,
.final-cta h2 {
  font-family: "Space Grotesk", sans-serif;
  line-height: 1.03;
}

.hero h1 {
  font-size: clamp(3.5rem, 7vw, 6.7rem);
  letter-spacing: -.06em;
  max-width: 720px;
}

.hero h1 span {
  color: transparent;
  -webkit-text-stroke: 1.5px #c7d2fe;
  text-stroke: 1.5px #c7d2fe;
}

.hero-text {
  max-width: 650px;
  margin: 28px 0 34px;
  color: var(--muted);
  font-size: 1.08rem;
}

.hero-actions {
  display: flex;
  gap: 14px;
  flex-wrap: wrap;
}

.btn {
  border: 1px solid transparent;
  border-radius: 14px;
  padding: 13px 20px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  cursor: pointer;
  transition: .25s ease;
  font: inherit;
  font-weight: 700;
}

.btn.primary {
  background: linear-gradient(135deg, #ffca28, #ff8c00);
  color: #131722;
  box-shadow: 0 12px 30px rgba(255, 156, 0, .25);
}

.btn.primary:hover { transform: translateY(-2px); }

.btn.ghost {
  border-color: var(--line);
  background: rgba(255,255,255,.035);
  color: white;
}

.hero-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  margin-top: 54px;
  max-width: 650px;
}

.hero-stats article {
  padding: 18px;
  border: 1px solid var(--line);
  border-radius: 16px;
  background: rgba(255,255,255,.025);
}

.hero-stats strong {
  display: block;
  font-size: 1.45rem;
  color: white;
}

.hero-stats span {
  color: var(--muted);
  font-size: .78rem;
}

.hero-visual {
  position: relative;
  aspect-ratio: 1;
  max-width: 520px;
  width: 100%;
  margin: auto;
  display: grid;
  place-items: center;
}

.sun {
  width: 310px;
  height: 310px;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 35%, #fff6bf 0 5%, #ffd166 25%, #ff9f1c 60%, #f97316 100%);
  box-shadow:
    0 0 35px rgba(255, 178, 0, .75),
    0 0 90px rgba(255, 145, 0, .42),
    0 0 160px rgba(255, 98, 0, .20);
  animation: pulseSun 4s ease-in-out infinite;
}

.moon {
  position: absolute;
  width: 305px;
  height: 305px;
  border-radius: 50%;
  background: radial-gradient(circle at 40% 35%, #20283d, #080b14 72%);
  box-shadow: inset -26px -22px 50px rgba(0,0,0,.65);
}

.corona {
  position: absolute;
  width: 338px;
  height: 338px;
  border-radius: 50%;
  border: 2px solid rgba(255, 236, 175, .55);
  box-shadow: 0 0 60px rgba(255, 216, 125, .25);
}

.orbit {
  position: absolute;
  width: 94%;
  height: 94%;
  border: 1px dashed rgba(255,255,255,.17);
  border-radius: 50%;
  transform: rotate(-15deg);
}

.label-orbit {
  position: absolute;
  right: -10px;
  top: 48%;
  color: var(--muted);
  font-size: .66rem;
  letter-spacing: .28em;
  transform: rotate(90deg);
}

@keyframes pulseSun {
  50% { transform: scale(1.015); }
}

.section {
  width: min(1180px, calc(100% - 32px));
  margin: 0 auto;
  padding: 100px 0;
}

.section-heading {
  max-width: 760px;
  margin-bottom: 48px;
}

.section-heading h2 {
  font-size: clamp(2.3rem, 4vw, 4rem);
  letter-spacing: -.045em;
  margin-bottom: 16px;
}

.section-heading > p:last-child {
  color: var(--muted);
  font-size: 1.02rem;
}

.process-grid {
  display: grid;
  grid-template-columns: 1fr 50px 1fr 50px 1fr;
  gap: 12px;
  align-items: stretch;
}

.process-card {
  padding: 28px;
  border: 1px solid var(--line);
  border-radius: 22px;
  background: var(--panel);
  box-shadow: var(--shadow);
  position: relative;
}

.planet-icon {
  width: 58px;
  height: 58px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  font-size: 1.8rem;
  margin-bottom: 30px;
}

.sun-icon { background: #ffb703; color: #111827; }
.moon-icon { background: #1f2937; color: #9ca3af; box-shadow: inset -8px -8px 15px rgba(0,0,0,.4); }
.earth-icon { background: #16213e; }

.step {
  position: absolute;
  top: 28px;
  right: 28px;
  color: #52607d;
  font-weight: 800;
}

.process-card h3,
.type-card h3,
.safety-grid h3 {
  font-family: "Space Grotesk", sans-serif;
  font-size: 1.35rem;
  margin-bottom: 8px;
}

.process-card p,
.type-card p {
  color: var(--muted);
}

.arrow {
  display: grid;
  place-items: center;
  color: var(--accent);
  font-size: 1.8rem;
}

.info-banner {
  margin-top: 18px;
  padding: 22px 24px;
  display: flex;
  gap: 14px;
  align-items: flex-start;
  background: rgba(125, 211, 252, .07);
  border: 1px solid rgba(125, 211, 252, .18);
  border-radius: 18px;
  color: #c5d5ec;
}

.types-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
}

.type-card {
  border: 1px solid var(--line);
  background: var(--panel);
  border-radius: 22px;
  padding: 22px;
  cursor: pointer;
  transition: .25s ease;
}

.type-card:hover,
.type-card.active {
  transform: translateY(-5px);
  border-color: rgba(255,183,3,.45);
  box-shadow: 0 18px 46px rgba(0,0,0,.30);
}

.type-visual {
  height: 190px;
  border-radius: 16px;
  background: radial-gradient(circle at center, #ffcf66 0 23%, #ff9d00 36%, #13192d 37%);
  display: grid;
  place-items: center;
  margin-bottom: 20px;
  overflow: hidden;
}

.type-visual span {
  width: 94px;
  height: 94px;
  border-radius: 50%;
  background: #070b14;
  display: block;
}

.partial-eclipse span { transform: translateX(30px); }
.annular-eclipse span { width: 79px; height: 79px; }
.hybrid-eclipse span { width: 88px; height: 88px; transform: translateX(5px); }

.tag {
  color: var(--accent) !important;
  font-size: .69rem;
  letter-spacing: .18em;
  font-weight: 800;
  margin-bottom: 8px;
}

.simulator-section {
  position: relative;
}

.simulator {
  display: grid;
  grid-template-columns: 1.25fr .75fr;
  border: 1px solid var(--line);
  border-radius: 28px;
  overflow: hidden;
  background: rgba(7, 11, 28, .78);
  box-shadow: var(--shadow);
}

.sim-space {
  min-height: 480px;
  position: relative;
  display: grid;
  place-items: center;
  background:
    radial-gradient(circle at center, rgba(255, 189, 46, .08), transparent 38%),
    #030612;
  overflow: hidden;
}

.sim-sun,
.sim-moon {
  position: absolute;
  width: 220px;
  height: 220px;
  border-radius: 50%;
}

.sim-sun {
  background: radial-gradient(circle at 35% 35%, #fff3b0, #ffb703 45%, #fb8500);
  box-shadow: 0 0 45px rgba(255, 183, 3, .75), 0 0 110px rgba(251, 133, 0, .25);
}

.sim-moon {
  background: radial-gradient(circle at 35% 30%, #242b42, #05070e 75%);
  z-index: 3;
  left: calc(50% - 110px);
  transition: left .12s linear;
}

.sim-glow {
  width: 245px;
  height: 245px;
  border-radius: 50%;
  border: 1px solid rgba(255, 237, 175, .35);
  box-shadow: 0 0 50px rgba(255, 214, 102, .17);
}

.controls {
  padding: 34px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 24px;
  background: linear-gradient(180deg, rgba(18, 27, 55, .98), rgba(10, 16, 35, .98));
}

.control-row {
  display: flex;
  justify-content: space-between;
  gap: 12px;
}

.control-row label { font-weight: 700; }
.control-row output { color: var(--accent); font-weight: 800; }

input[type="range"] {
  width: 100%;
  accent-color: var(--accent);
}

.sim-result {
  display: grid;
  gap: 12px;
}

.sim-result > div {
  padding: 16px 18px;
  border-radius: 14px;
  background: rgba(255,255,255,.04);
  border: 1px solid var(--line);
}

.sim-result span {
  display: block;
  color: var(--muted);
  font-size: .78rem;
}

.sim-result strong {
  font-size: 1.3rem;
}

.full { width: 100%; }

.safety-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18px;
}

.safety-grid article {
  padding: 30px;
  background: rgba(85, 230, 165, .055);
  border: 1px solid rgba(85, 230, 165, .20);
  border-radius: 22px;
}

.safety-grid article.danger {
  background: rgba(255, 107, 107, .05);
  border-color: rgba(255, 107, 107, .20);
}

.safe-icon {
  width: 46px;
  height: 46px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: var(--green);
  color: #06140f;
  font-weight: 900;
  margin-bottom: 18px;
}

.danger .safe-icon {
  background: var(--danger);
  color: white;
}

.safety-grid ul {
  list-style: none;
  margin-top: 16px;
  display: grid;
  gap: 12px;
  color: var(--muted);
}

.safety-grid li::before {
  content: "•";
  color: var(--green);
  margin-right: 10px;
}

.danger li::before { color: var(--danger); }

.quiz-card {
  max-width: 820px;
  padding: 34px;
  border-radius: 24px;
  background: var(--panel);
  border: 1px solid var(--line);
  box-shadow: var(--shadow);
}

.quiz-progress {
  margin-bottom: 28px;
}

.quiz-progress span {
  display: block;
  color: var(--muted);
  font-size: .82rem;
  margin-bottom: 10px;
}

.progress-track {
  width: 100%;
  height: 7px;
  border-radius: 999px;
  background: rgba(255,255,255,.08);
  overflow: hidden;
}

#progressBar {
  height: 100%;
  width: 33.33%;
  background: linear-gradient(90deg, var(--accent), var(--accent-2));
  transition: .25s ease;
}

.quiz-card h3 {
  font-size: 1.55rem;
  margin-bottom: 24px;
}

.answers {
  display: grid;
  gap: 12px;
}

.answer-btn {
  text-align: left;
  padding: 15px 17px;
  background: rgba(255,255,255,.035);
  border: 1px solid var(--line);
  color: white;
  border-radius: 13px;
  font: inherit;
  cursor: pointer;
  transition: .2s ease;
}

.answer-btn:hover { border-color: rgba(255,183,3,.40); }
.answer-btn.correct { border-color: var(--green); background: rgba(85,230,165,.08); }
.answer-btn.wrong { border-color: var(--danger); background: rgba(255,107,107,.07); }

.quiz-footer {
  margin-top: 24px;
  padding-top: 20px;
  border-top: 1px solid var(--line);
  display: flex;
  justify-content: space-between;
  gap: 20px;
  align-items: center;
}

#feedback { color: var(--muted); }

.final-cta {
  text-align: center;
  padding-top: 120px;
  padding-bottom: 120px;
}

.final-cta h2 {
  max-width: 760px;
  margin: 0 auto 18px;
  font-size: clamp(2.5rem, 5vw, 5rem);
  letter-spacing: -.05em;
}

.final-cta > p:not(.eyebrow) {
  max-width: 700px;
  margin: 0 auto 28px;
  color: var(--muted);
}

footer {
  width: min(1180px, calc(100% - 32px));
  margin: 0 auto 30px;
  padding: 28px 0 14px;
  border-top: 1px solid var(--line);
  display: flex;
  justify-content: space-between;
  gap: 20px;
  color: var(--muted);
}

footer strong { color: white; }
.author { text-align: right; }

@media (max-width: 950px) {
  .nav {
    display: none;
    position: absolute;
    top: 78px;
    left: 0;
    right: 0;
    padding: 18px;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: rgba(6, 10, 25, .97);
  }

  .nav.open { display: flex; }
  .menu-btn { display: block; }

  .hero {
    grid-template-columns: 1fr;
    min-height: auto;
    padding-top: 100px;
  }

  .hero-visual { max-width: 430px; }

  .types-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .simulator {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 700px) {
  .hero-stats { grid-template-columns: 1fr; }

  .process-grid {
    grid-template-columns: 1fr;
  }

  .arrow { transform: rotate(90deg); }

  .types-grid,
  .safety-grid {
    grid-template-columns: 1fr;
  }

  .section { padding: 72px 0; }

  .sun { width: 245px; height: 245px; }
  .moon { width: 240px; height: 240px; }
  .corona { width: 267px; height: 267px; }

  .hero { gap: 20px; }
  .hero-visual { min-height: 390px; }

  .quiz-footer,
  footer {
    flex-direction: column;
    align-items: flex-start;
  }

  .author { text-align: left; }
}
